{
  "manifest_version": 3,
  "name": "JARVIS Veil Sensor",
  "version": "0.2.0",
  "description": "Opt-in, metadata-only local browser privacy sensor for JARVIS, with opt-in session-recorder and tracking-pixel blocking.",
  "permissions": ["storage", "declarativeNetRequest"],
  "host_permissions": ["http://127.0.0.1:8787/*", "http://localhost:8787/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "content_scripts": [
    {"matches": ["http://*/*", "https://*/*"], "js": ["probe.js"], "run_at": "document_start", "world": "MAIN", "all_frames": false},
    {"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_start"}
  ],
  "declarative_net_request": {
    "rule_resources": [
      {"id": "replay", "enabled": false, "path": "rules/replay.json"},
      {"id": "pixels", "enabled": false, "path": "rules/pixels.json"}
    ]
  },
  "action": {"default_title": "JARVIS Veil Sensor"},
  "options_page": "options.html"
}
