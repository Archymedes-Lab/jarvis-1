# PowerShell payloads are loaded byte for byte (see core/paths.load_win_script);
# keep their line endings fixed regardless of the checkout platform.
jarvis/platform/win/*.ps1 text eol=lf

# Vendored assets are served against pinned SHA-256 hashes (web/server.py); never convert line endings.
jarvis/web/static/vendor/* -text
jarvis/web/static/vendor/leaflet/* -text
jarvis/web/static/vendor/leaflet/images/* -text
