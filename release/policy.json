  "_markers_comment": "Searched in every file's bytes, binaries included. Home-folder markers refuse any user's home path except a short list of placeholder names (u, x, alice, Public, ...) that Argus's own detection rules and self-tests use as examples; build-path markers name our CI environments. A private-key header counts only with key material after it, with real or escaped (\\\\n) newlines, so a scanner's own rules may name the header. Third-party libraries get no exemption: their maintainers' paths (/github/home/, /opt/_internal/) are not home folders and are not ours. A Windows home seen through a WSL mount (/mnt/c/Users/<name>/) is a home folder too: the macOS and Windows markers missed it because of the drive letter before /Users, and the 2026.10.30-2 server release shipped one (2026-11-02).",
  "deny_markers": [
    {
      "id": "home-path",
      "regex": "(?<![A-Za-z0-9_])/home/(?!(?:u|x|a|b|user|you|alice|bob|ubuntu|example)/)[A-Za-z_][A-Za-z0-9_.-]*/"
    },
    {
      "id": "build-path",
      "regex": "(?<![A-Za-z0-9_])(?:/github/workspace/|/__w/|/tmp/argus-(?:server|desktop)-|/root/\\.(?:cargo|rustup|cache)/)"
    },
    {
      "id": "macos-home-path",
      "regex": "(?<![A-Za-z0-9_])/Users/(?!(?:Shared|u|x|a|user|you|example)/)[A-Za-z_][A-Za-z0-9_.-]*/"
    },
    {
      "id": "windows-home-path",
      "regex": "(?i)[A-Z]:\\\\Users\\\\(?!(?:u|x|a|b|user|you|alice|bob|example|Public|Default|All Users)\\\\)[A-Za-z_][A-Za-z0-9_.-]*\\\\"
    },
    {
      "id": "wsl-windows-home-path",
      "regex": "(?i)(?<![A-Za-z0-9_])/mnt/[a-z]/Users/(?!(?:u|x|a|b|user|you|alice|bob|example|Public|Default|All Users)/)[A-Za-z_][A-Za-z0-9_.-]*/"
    },
    {
      "id": "windows-build-path",
      "regex": "(?i)(?:[A-Z]:\\\\a\\\\[A-Za-z0-9_.-]+\\\\|[A-Z]:\\\\actions-runner\\\\)"
    },
    {
      "id": "private-key",
      "regex": "-----BEGIN [A-Z ]*PRIVATE KEY-----(?:\\r?\\n|\\\\(?:r\\\\)?n)(?:[A-Za-z0-9-]+: [^\\n\\\\]*(?:\\r?\\n|\\\\(?:r\\\\)?n))*(?:\\r?\\n|\\\\(?:r\\\\)?n)?[A-Za-z0-9+/=]{40}"
    },
    {
      "id": "github-token",
      "regex": "\\b(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{36}\\b|\\bgithub_pat_[A-Za-z0-9_]{60,}\\b"
    },
    {
      "id": "aws-key",
      "regex": "\\bAKIA[0-9A-Z]{16}\\b"
    },
    {
      "id": "slack-token",
      "regex": "\\bxox[abposr]-[A-Za-z0-9-]{10,}"
    },
    {
      "id": "source-map",
      "regex": "sourceMappingURL="
    },
    {
      "id": "python-source-header",
      "regex": "^#!/usr/bin/env python|^# -\\*- coding"
    }
  ],
  "_python_comment": "Byte signatures of Python source or bytecode hidden in an allowed file (a renamed .pyc, a zip appended to a binary). Magic numbers: 3.10 (6f 0d), 3.11 (a7 0d), 3.12 (cb 0d), 3.13 (f3 0d), each followed by \\r\\n.",
