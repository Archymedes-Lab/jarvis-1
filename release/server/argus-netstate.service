[Unit]
Description=Argus firewall snapshot - read-only listing of the netfilter ruleset
Documentation=https://www.archymedes.xyz/en/solutions/argus/

[Service]
Type=oneshot
User=argus-net
Group=argus-net
Environment=HOME=/var/lib/argus-net
WorkingDirectory=/
# Fixed listing commands only (nft -j list ruleset, ufw status, firewall-cmd
# --list-all); no argument reaches them. CAP_NET_ADMIN is what reading the
# ruleset needs; nothing here writes a rule.
ExecStart=/opt/argus/bin/argus-server netstate
TimeoutStartSec=90

AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
RestrictAddressFamilies=AF_NETLINK AF_UNIX
ProtectSystem=strict
ReadWritePaths=/var/lib/argus-net
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
UMask=0027
Nice=10
CPUWeight=20
MemoryMax=128M
