{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The bundled interface: read the daemon's state through typed commands, listen for pulses. No file, shell, HTTP or window API; the licence screen can open only allow-listed pay.archymedes.xyz pages (api.rs valid_licence_page).",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-daemon-state",
    "allow-daemon-status",
    "allow-app-status",
    "allow-run-collector",
    "allow-answer-question",
    "allow-ask-jarvis",
    "allow-score-coach",
    "allow-decide-fix",
    "allow-billing-status",
    "allow-billing-checkout",
    "allow-autopilot-status",
    "allow-autopilot-decide",
    "allow-autopilot-policy",
    "allow-get-settings",
    "allow-set-settings",
    "allow-pause-monitoring",
    "allow-resume-monitoring",
    "allow-protection-status",
    "allow-protection-scan",
    "allow-geo-state",
    "allow-coverage-state",
    "allow-world-state",
    "allow-procs-baseline",
    "allow-procs-snapshot",
    "allow-open-page",
    "allow-phone-status",
    "allow-phone-devices",
    "allow-phone-pair-current",
    "allow-phone-pair-start",
    "allow-phone-pair-poll",
    "allow-phone-pair-confirm",
    "allow-phone-pair-cancel",
    "allow-phone-revoke",
    "allow-phone-test",
    "allow-app-version",
    "allow-check-update",
    "allow-open-download-page",
    "allow-licence-state",
    "allow-licence-action",
    "allow-open-licence-page"
  ]
}
