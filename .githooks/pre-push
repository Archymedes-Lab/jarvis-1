#!/usr/bin/env bash
# Runs before every `git push` once scripts/dev/bootstrap.sh enabled .githooks.
# CI minutes are a shared, small budget (.github/workflows/ci.yml): a push that fails here would only
# have failed in CI. Quick gate (ruff + mypy) and the tests whose inputs changed (cached, usually seconds).
# Skip once with `git push --no-verify` (docs-only pushes, an emergency); CI still runs everything.
set -euo pipefail
cd -- "$(git rev-parse --show-toplevel)"
# Branch deletions push no code.
while read -r _local local_sha _remote _remote_sha; do
  [[ "$local_sha" =~ ^0+$ ]] || { changed=1; break; }
done
[[ "${changed:-0}" == 1 ]] || exit 0
echo "pre-push: quick static gate"
scripts/dev/static_gate.sh --quick
echo "pre-push: changed tests"
python3 scripts/dev/fasttest.py
